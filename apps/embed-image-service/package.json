{
    "name": "@spqtify/embed-image-service",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
        "check": "tsc --noEmit -p tsconfig.json",
        "test": "tsx --test test/*.test.ts",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@effect/platform": "0.97.2",
        "@effect/platform-node": "0.108.4",
        "@resvg/resvg-js": "^2.6.2",
        "@spqtify/embed-image": "workspace:",
        "effect": "3.22.4",
        "node-vibrant": "^4.0.4",
        "satori": "^0.63.0"
    },
    "devDependencies": {
        "@spqtify/tsconfig": "workspace:^",
        "tsc-alias": "^1.8.17",
        "tsx": "4.23.15",
        "typescript": "6.0.3"
    }
}
